# Database
DATABASE_URL=postgresql://templatelab:templatelab@localhost:5432/templatelab

# Crawler settings (conservative defaults)
CRAWL_DELAY=2.0
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CRAWL_INTERVAL_HOURS=168
FORCE_RECRAWL=false

# User agent - identify as ethical research crawler
USER_AGENT=TemplateLabEthicalCrawler/1.0 (+https://example.com/bot; research)

# Optional: Playwright (only when JS rendering is required and permitted)
USE_PLAYWRIGHT=false
HEADLESS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
